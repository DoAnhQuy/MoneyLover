<?xml version="1.0" encoding="utf-8"?>
<!-- Bàn phím máy tính: hiện khi bấm Sửa (màn Ngân sách hoặc Cài đặt ngân sách) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtCalculatorValue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="end|center_vertical"
            android:hint="0"
            android:paddingHorizontal="12dp"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Ô nhập ghi chú -->
        <EditText
            android:id="@+id/edtNote"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_note"
            android:hint="Thêm ghi chú..."
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:rowCount="4">

            <Button
                android:id="@+id/btnCalc7"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="7" />

            <Button
                android:id="@+id/btnCalc8"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="8" />

            <Button
                android:id="@+id/btnCalc9"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="9" />

            <Button
                android:id="@+id/btnCalc4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="4" />

            <Button
                android:id="@+id/btnCalc5"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="5" />

            <Button
                android:id="@+id/btnCalc6"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="6" />

            <Button
                android:id="@+id/btnCalc1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="1" />

            <Button
                android:id="@+id/btnCalc2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="2" />

            <Button
                android:id="@+id/btnCalc3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="3" />

            <Button
                android:id="@+id/btnCalcClear"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="C"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/black" />

            <Button
                android:id="@+id/btnCalc0"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="0" />

            <Button
                android:id="@+id/btnCalcBack"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="⌫" />
        </GridLayout>

        <Button
            android:id="@+id/btnCalcDone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_report_card_yellow"
            android:text="Xong"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
