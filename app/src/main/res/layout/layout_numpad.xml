<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="8dp">

    <!-- Hàng 1: 1 2 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCalc1"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="1"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:background="@drawable/bg_button_numpad" />

        <Button
            android:id="@+id/btnCalc2"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="2"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:background="@drawable/bg_button_numpad" />

        <Button
            android:id="@+id/btnCalc3"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="3"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:background="@drawable/bg_button_numpad" />
    </LinearLayout>

    <!-- Hàng 2: 4 5 6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCalc4"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="4"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:background="@drawable/bg_button_numpad" />

        <Button
            android:id="@+id/btnCalc5"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="5"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:background="@drawable/bg_button_numpad" />

        <Button
            android:id="@+id/btnCalc6"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="6"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:background="@drawable/bg_button_numpad" />
    </LinearLayout>

    <!-- Hàng 3: 7 8 9 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCalc7"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="7"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:background="@drawable/bg_button_numpad" />

        <Button
            android:id="@+id/btnCalc8"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="8"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:background="@drawable/bg_button_numpad" />

        <Button
            android:id="@+id/btnCalc9"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="9"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:background="@drawable/bg_button_numpad" />
    </LinearLayout>

    <!-- Hàng 4: Xóa hết | 0 | back -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCalcClear"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="C"
            android:textSize="24sp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/black"
            android:background="@drawable/bg_button_numpad" />

        <Button
            android:id="@+id/btnCalc0"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="0"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:background="@drawable/bg_button_numpad" />

        <ImageButton
            android:id="@+id/btnCalcBack"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:src="@drawable/ic_backspace"
            android:background="@drawable/bg_button_numpad"
            android:scaleType="center"
            android:contentDescription="Xóa" />
    </LinearLayout>

    <!-- Nút Xác nhận -->
    <Button
        android:id="@+id/btnCalcDone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="4dp"
        android:layout_marginTop="8dp"
        android:text="Xác nhận"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary" />

</LinearLayout>
